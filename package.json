{
  "name": "comic-code",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm --filter @comic-code/web build",
    "dev": "pnpm extension:build && pnpm --filter @comic-code/web dev --hostname 127.0.0.1",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "extension:build": "node scripts/extension.mjs build",
    "extension:zip": "node scripts/extension.mjs zip",
    "check": "pnpm test && pnpm lint && pnpm format:check && pnpm build && pnpm typecheck",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:preview": "node scripts/smoke-preview.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
