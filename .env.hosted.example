COMIC_CODE_MODE=hosted

# Copy to .env. Add real values only to the ignored .env file.

NEXT_PUBLIC_APP_URL=http://localhost:3000
WXT_PUBLIC_API_BASE_URL=http://localhost:3000

TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=

GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
# Hosted extension OAuth recipients. Comma-separated IDs from chrome://extensions.
# Empty permits web login only. Local mode never needs OAuth or this setting.
ALLOWED_EXTENSION_IDS=
GITHUB_APP_SLUG=

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

SHARE_TOKEN_PEPPER=
SAFETY_IDENTIFIER_SECRET=
SESSION_ENCRYPTION_SECRET=
CRON_SECRET=
