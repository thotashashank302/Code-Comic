{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NEXT_PUBLIC_APP_URL", "WXT_PUBLIC_API_BASE_URL"],
  "globalPassThroughEnv": [
    "GITHUB_APP_ID",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "GITHUB_PRIVATE_KEY_BASE64",
    "GITHUB_WEBHOOK_SECRET",
    "GITHUB_APP_SLUG",
    "NEXT_PUBLIC_SUPABASE_URL",
    "SUPABASE_SECRET_KEY",
    "SHARE_TOKEN_PEPPER",
    "SAFETY_IDENTIFIER_SECRET",
    "SESSION_ENCRYPTION_SECRET",
    "TRIGGER_SECRET_KEY",
    "CRON_SECRET",
    "COMIC_CODE_MODE",
    "COMIC_CODE_DATA_DIR",
    "GITHUB_TOKEN",
    "WXT_PUBLIC_API_BASE_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", ".output/**", "dist/**"]
    },
    "@comic-code/comic#build": {
      "outputs": []
    },
    "@comic-code/contracts#build": {
      "outputs": []
    },
    "@comic-code/database#build": {
      "outputs": []
    },
    "@comic-code/ui#build": {
      "outputs": []
    },
    "@comic-code/github#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
