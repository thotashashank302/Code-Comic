# Optional: local mode works without an env file or service accounts.
COMIC_CODE_MODE=local
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
WXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

# Optional server-side GitHub token for a higher public API request limit.
# Never use a NEXT_PUBLIC_ or WXT_PUBLIC_ prefix for this token.
GITHUB_TOKEN=

# Optional absolute directory on a persistent local disk.
# COMIC_CODE_DATA_DIR=/absolute/path/to/comic-data
